# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# .env.local is git-ignored. Never commit real keys.

# --- Safe for the browser -----------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the JavaScript sent to visitors.
# The publishable (anon) key is designed to be public: Row Level Security
# in supabase/migrations decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: map tiles. Defaults to OpenStreetMap (no key needed, light use only).
# A tile provider's key is a BROWSER key: it ends up in the page no matter what,
# so restrict it to your domain in the provider's dashboard.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_DOMAIN_RESTRICTED_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# --- Server only: NEVER add a NEXT_PUBLIC_ prefix -----------------------------
# The secret (service role) key BYPASSES Row Level Security, so anyone who has
# it has full access to the database. Use it only in server code (Route
# Handlers, Server Actions, scripts) that starts with `import "server-only"`.
# Without the NEXT_PUBLIC_ prefix, Next.js won't include it in browser code.
SUPABASE_SECRET_KEY=
